{
    "extends": "cfg.jsonc",
    "model": {
        "type": "testnet_prealign_spmf20"
    },
    "scheduler": {
        "type": "MultiStepLR",
        "milestones": [33, 43],
        "gamma": 0.1
    },
    "stages": [
        {
            "epochs": [1, 20],
            "freeze_modules": [],
            "loss": ["ce"],
            "default_lr": 0.01,
            "module_lrs": {
                "spmf_fusion20": 0.001,
                "structure_branch10": 0.001
            }
        },
        {
            "epochs": [21, 48],
            "freeze_modules": [],
            "loss": ["ce"],
            "default_lr": 0.01,
            "module_lrs": {
                "aux_prealign": 0.001
            }
        }
    ],
    "train": {
        "max_epochs": 48
    }
}
