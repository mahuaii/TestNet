{
    "scheduler": {
        "type": "MultiStepLR",
        "milestones": [44, 48],
        "gamma": 0.1
    },
    "stages": [
        {
            "name": "stage1_prealign_main",
            "epochs": [1, 25],
            "freeze_modules": ["spmf_fusion", "structure_branch"],
            "loss": ["ce"],
            "default_lr": 0.01,
            "module_lrs": {
                "aux_prealign": 0.01
            }
        },
        {
            "name": "stage2_structure_spmf_with_slow_prealign",
            "epochs": [26, 44],
            "freeze_modules": [],
            "loss": ["ce"],
            "default_lr": 0.01,
            "module_lrs": {
                "aux_prealign": 0.003,
                "spmf_fusion": 0.01,
                "structure_branch": 0.01
            }
        },
        {
            "name": "stage3_joint_decay",
            "epochs": [45, 52],
            "freeze_modules": [],
            "loss": ["ce"],
            "default_lr": 0.01,
            "module_lrs": {
                "aux_prealign": 0.003,
                "spmf_fusion": 0.01,
                "structure_branch": 0.01
            }
        }
    ]
}
