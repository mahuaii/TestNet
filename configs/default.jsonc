{
    "extends": [
        "defaults/dataset_vaihingen.jsonc"
    ],
    "model": {
        "type": "",
        "num_classes": 6,
        "sam_backbone": "vit_b",
        "sam_checkpoint": "_Checkpoints/segment-anything/sam_vit_b_01ec64.pth",
        "detach_dsm_taps": true,
        "record_intermediate_stats": false,
        "record_intermediate_modules": []
    },
    "dataset": {
        "cache": true,
        "augmentation": true,
        "dsm_preprocessing": {
            "enabled": false,
            "type": "similarity_enhancement",
            "window_size": 7,
            "sigma": 0.15,
            "lambda_weight": 0.2
        },
        "train_samples_per_epoch": 10000,
        "val_samples_per_epoch": 4
    },
    "dataloader": {
        "num_workers": 0
    },
    "loss": [
        "ce"
    ],
    "loss_weights": {
        "ce": 1.0,
        "lovasz": 0.2,
        "boundary": 0.05
    },
    "optimizer": {
        "type": "SGD",
        "lr": 0.01,
        "momentum": 0.9,
        "weight_decay": 0.0005
    },
    "scheduler": {
        "type": "MultiStepLR",
        "milestones": [
            25,
            35,
            45
        ],
        "gamma": 0.1
    },
    "train": {
        "max_epochs": 48,
        "batch_size": 10,
        "auto_resume": true,
        "log_step_interval": 100,
        "val_epoch_interval": 4,
        "save_epoch_interval": 0,
        "save_step_interval": 0,
        "use_tensorboard": true,
        "diagnostics": {
            "enabled": false,
            "log_trainable_params": false,
            "log_prealign_spmf_stats": false
        }
    }
}
