{
    "extends": "cfg.jsonc",
    "model": {
        "type": "testnet_prealign_spmf20"
    },
    "stages": [
        {
            "epochs": [1, 20],
            "freeze_modules": ["spmf_fusion20", "structure_branch10"],
            "loss": ["ce"]
        },
        {
            "epochs": [21, 48],
            "freeze_modules": [],
            "loss": ["ce"]
        }
    ],
    "train": {
        "max_epochs": 48
    }
}
