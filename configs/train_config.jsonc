{
    "model": {
        "type": "mfnet_unetformer",
        "num_classes": 6,
        "sam_checkpoint": "_Checkpoints/segment-anything/sam_vit_b_01ec64.pth"
    },
    "dataset": {
        "name": "vaihingen",
        "root_dir": "./datasets/vaihingen",
        "patch_size": [
            256,
            256
        ],
        "cache": true,
        "augmentation": true,
        "train_ids": [
            "1",
            "3",
            "23",
            "26",
            "7",
            "11",
            "13",
            "28",
            "17",
            "32",
            "34",
            "37"
        ],
        "val_ids": [
            "5",
            "21",
            "15",
            "30"
        ],
        "train_samples_per_epoch": 10000, //BATCH_SIZE * 1000
        "val_samples_per_epoch": 4
    },
    "dataloader": {
        "num_workers": 0
    },
    "optimizer": {
        "type": "SGD",
        "lr": 0.01,
        "momentum": 0.9,
        "weight_decay": 0.0005
    },
    "scheduler": {
        "type": "MultiStepLR",
        "milestones": [
            25,
            35,
            45
        ],
        "gamma": 0.1
    },
    "validation": {
        "stride": 32
    },
    "train": {
        "max_epochs": 50,
        "batch_size": 10,
        "auto_resume": true,
        "log_step_interval": 100,
        "val_epoch_interval": 2,
        "save_epoch_interval": 2,
        "save_step_interval": 0,
        "use_tensorboard": true
    }
}