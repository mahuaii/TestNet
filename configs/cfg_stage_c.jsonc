{
    "extends": "cfg.jsonc",
    "model": {
        "type": "testnet_prealign_spmf20"
    },
    "scheduler": {
        "type": "MultiStepLR",
        "milestones": [40, 52],
        "gamma": 0.1
    },
    "optimizer": {
        "adapter_lr": 0.01
    },
    "stages": [
        {
            "epochs": [1, 8],
            "freeze_modules": ["spmf_fusion20", "structure_branch10"],
            "loss": ["ce"],
            "default_lr": 0.01,
            "module_lrs": {
                "aux_prealign": 0.01
            }
        },
        {
            "epochs": [9, 40],
            "freeze_modules": [],
            "loss": ["ce"],
            "default_lr": 0.01,
            "module_lrs": {
                "aux_prealign": 0.003,
                "spmf_fusion20": 0.01,
                "structure_branch10": 0.01
            }
        },
        {
            "epochs": [41, 60],
            "freeze_modules": [],
            "loss": ["ce"],
            "default_lr": 0.01,
            "module_lrs": {
                "aux_prealign": 0.003,
                "spmf_fusion20": 0.01,
                "structure_branch10": 0.01
            }
        }
    ],
    "train": {
        "max_epochs": 60
    }
}
